                       hour >= 12 && hour < 18 ? "下午好" : 
                       hour >= 18 && hour < 22 ? "晚上好" : "夜深了";

    const welcomeTextList = [
      `${timePeriod}！欢迎来到澄思竹的博客，这里有校园日常和技术碎碎念～`,
