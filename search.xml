      `${timePeriod}！技术虽菜但热情满分，生活平淡却过得有滋有味，这就是我的博客～`
    ];

    const randomTxt = welcomeTextList[Math.floor(Math.random() * welcomeTextList.length)];
    const welcomeTextEl = document.getElementById("welcome-text");
    if (welcomeTextEl) {
      welcomeTextEl.innerText = randomTxt; 
    }

    function switchWelcomeText() {
      const newRandomTxt = welcomeTextList[Math.floor(Math.random() * welcomeTextList.length)];
